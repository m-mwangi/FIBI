# Copy to `.env` next to docker-compose.yml, then edit secrets.

# --- PostgreSQL connection (required) ---
# Use ONE of the patterns below.

# A) Postgres on your Ubuntu machine (installed locally, managed with pgAdmin, etc.)
#    Hostname must be host.docker.internal so the backend *container* can reach the host.
#    Match user/password/database/port to what you created in pgAdmin.
#    Special characters in the password must be URL-encoded (e.g. @ -> %40).
DATABASE_URL=postgresql://omwansam:Falcon%407Fibi@host.docker.internal:5433/fibi
# If you use default port 5432 instead:
# DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@host.docker.internal:5432/YOUR_DB

# Allow Docker to connect: in postgresql.conf set listen_addresses = '*' (or at least your LAN IP),
# and in pg_hba.conf add a line for the Docker bridge, e.g.:
#   host all all 172.16.0.0/12 scram-sha-256
#   host all all 172.17.0.0/16 scram-sha-256
# Then: sudo systemctl reload postgresql

# B) Postgres only inside Docker (optional service)
#    DATABASE_URL=postgresql://fibi:your-bundled-password@postgres:5432/fibi
#    Start with: docker compose --profile bundled-db up -d --build
#    (POSTGRES_* below are only used by that bundled service.)



# --- Backend ---
JWT_SECRET=3e7262fb18190b962c35a39f
JWT_EXPIRES_IN=1d

# Public site URL (scheme + host, no trailing slash). Used for CORS.
# Replace with your real domain before deployment.
FRONTEND_URL=https://yourdomain.com

# OAuth / Stripe (optional; leave empty if unused)
GOOGLE_CLIENT_ID=908924091346-0aut6oon5vrt13f6jm1p57glnm3289kq.apps.googleusercontent.com
APPLE_CLIENT_ID=your_apple_client_id_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Set to "false" only if you run migrations manually: docker compose run --rm backend npx prisma migrate deploy
RUN_MIGRATIONS=true

# --- Frontend build-time (rebuild image after changes) ---
# Leave empty so the browser calls /api on the same host (nginx proxies to backend).
VITE_API_URL=

VITE_GOOGLE_CLIENT_ID=908924091346-0aut6oon5vrt13f6jm1p57glnm3289kq.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=
VITE_APPLE_CLIENT_ID=your_apple_client_id_here
# Must match your Apple Services ID redirect URL in production (https).
VITE_APPLE_REDIRECT_URI=

# --- Proxy ---
HTTP_PORT=80
