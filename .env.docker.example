# FIBI production environment — copy to `.env` beside docker-compose.yml.
#
#   cp .env.docker.example .env
#   nano .env            # fill in every REPLACE_ME
#   chmod 600 .env       # this file holds live secrets
#
# `.env` is gitignored. Never commit it.

# --- Site ---------------------------------------------------------------------
# Apex domain, no scheme and no trailing slash. www.<DOMAIN> is covered by the
# same certificate and 301s to the apex.
DOMAIN=fibicommunity.org

# Public site URL (scheme + host, no trailing slash). Drives backend CORS.
FRONTEND_URL=https://fibicommunity.org

# Where Let's Encrypt sends expiry warnings. A real, monitored mailbox.
CERTBOT_EMAIL=REPLACE_ME@fibicommunity.org

# --- Cloudflare ---------------------------------------------------------------
# fibicommunity.org is served through Cloudflare, so this is true.
#
# With the orange cloud on, every request reaches this server from a Cloudflare
# edge address. This flag makes nginx trust the CF-Connecting-IP header from
# Cloudflare's published ranges, so rate limiting, logging and Express all see
# the real visitor. Left false while proxying is on, a handful of edge IPs share
# every rate-limit bucket and the limits become both useless and disruptive.
#
# Safe to leave true during the initial certificate issuance, when the records
# are temporarily set to "DNS only": traffic then arrives directly, matches none
# of the Cloudflare ranges, and the peer address is used as-is.
#
# Set it to false only if this stack is ever served without Cloudflare in front.
CLOUDFLARE=true

# --- PostgreSQL (bundled container) -------------------------------------------
# The database is NOT published to the internet — it is reachable only on the
# internal Docker network, so `postgres` is the correct hostname.
#
# Generate a password:  openssl rand -base64 32 | tr -d '/+=' | head -c 32
# If yours contains @ : / ? # [ ] they must be percent-encoded in DATABASE_URL
# (@ -> %40, : -> %3A). Sticking to alphanumerics avoids the whole problem.
POSTGRES_USER=fibi
POSTGRES_PASSWORD=REPLACE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=fibi

DATABASE_URL=postgresql://fibi:REPLACE_ME_STRONG_DB_PASSWORD@postgres:5432/fibi

# --- Backend ------------------------------------------------------------------
# Generate:  openssl rand -hex 32
# Rotating this invalidates every issued session token.
JWT_SECRET=REPLACE_ME_RUN_openssl_rand_hex_32
JWT_EXPIRES_IN=1d

# Run `prisma migrate deploy` on container start. Leave true so a deploy applies
# pending migrations automatically.
RUN_MIGRATIONS=true

# Number of proxy hops in front of Express. Leave this at 1 — including behind
# Cloudflare. The edge proxy overwrites X-Forwarded-For with the single client
# address it has already resolved (see deploy/nginx.conf), so Express only ever
# has one hop to trust. Raising it lets clients spoof their own IP.
#
# This value also decides what the auth rate limiters see as the client IP. Set
# it wrong and every request appears to come from the proxy, collapsing all
# per-IP limits into one shared bucket.
TRUST_PROXY=1

# --- Outbound mail (password reset) -------------------------------------------
# REQUIRED IN PRODUCTION. With SMTP_HOST unset the API refuses to send a reset it
# cannot deliver; in development it prints the reset link to the container log
# instead, so the flow is testable without a mail provider.
# Port 587 uses STARTTLS, 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=FIBI <no-reply@fibicommunity.org>

# --- Frontend build args ------------------------------------------------------
# Leave VITE_API_URL EMPTY. The proxy serves the SPA and /api from the same
# origin, so the browser uses relative URLs and no CORS preflight is needed.
VITE_API_URL=

# --- OAuth (optional; leave blank to disable a provider) ----------------------
# The GOOGLE_CLIENT_ID pair must be the same client ID on both sides: the
# frontend obtains the token, the backend verifies its audience.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

APPLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=https://fibicommunity.org/auth/apple/callback

VITE_FACEBOOK_APP_ID=

# --- Stripe (optional; leave blank to disable payments) -----------------------
# Use the LIVE key in production (sk_live_...).
STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint:
#   https://fibicommunity.org/api/v1/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Ports (rarely changed) ---------------------------------------------------
# Only touch these if something else on the VPS already owns 80/443.
HTTP_PORT=80
HTTPS_PORT=443
