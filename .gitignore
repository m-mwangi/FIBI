# Dependencies and build output — regenerated by `npm ci` and `npm run build`,
# and rebuilt inside the Docker images at deploy time. Never committed.
node_modules/
**/node_modules/
.vite/
dist/
build/

# --- Secrets ------------------------------------------------------------------
# Anything that holds live credentials. The patterns are deliberately broad
# (.env.production, backend.env, .env.local.bak, ...) because the cost of an
# over-broad ignore is a file someone has to force-add, while the cost of a gap
# is a credential in git history forever.
.env
.env.*
*.env
*.env.*

# Keep the placeholder templates tracked — they contain REPLACE_ME, never values.
!.env.example
!*.env.example
!.env.docker.example

# Certificates, keys and credential bundles.
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
*.gpg
secrets.json
credentials.json
service-account*.json

# Database dumps and volume backups — these carry live user data even though
# they carry no passwords.
*.sql.gz
*.dump
uploads-*.tar.gz
fibi-*.sql.gz

# Let's Encrypt material, if anyone ever copies it out of the Docker volume.
letsencrypt/
certbot/

# --- Local artifacts ----------------------------------------------------------
*.log
.DS_Store
.idea/
.vscode/
coverage/
.cache/
*.tsbuildinfo
