# Copy to .env.development (local) or .env.production (production build).
# No trailing slash. Must match where your Express API is reachable.

# Local (default in code is http://localhost:5000 if unset)
VITE_API_URL=http://localhost:5000

# Example: VPS with API on a subdomain
# VITE_API_URL=https://api.yourdomain.com

# Example: same machine, custom backend port
# VITE_API_URL=http://localhost:4000
