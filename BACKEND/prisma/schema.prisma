// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
} 

//////////////////////////////////////////////////////
// ENUMS (FIXED VALUE SETS)
// These restrict fields to predefined values
//////////////////////////////////////////////////////

// User roles in the system
enum UserRole {
  investor
  admin
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
  APPLE
}

// Identification types (mapped to DB-friendly strings)
enum IdType {
  passport
  national_id   @map("national_id")  // map to national_id in the database
  drivers_license   @map("drivers_license") // map to drivers_license in the database
}

// Project lifecycle states
enum ProjectStatus {
  open
  funded
  active
  closed
}

// Timeline progress states
enum TimelineStatus {
  completed
  in_progress      @map("in-progress")
  upcoming
}

// Investment lifecycle
enum InvestmentStatus {
  pending
  active
  completed
}

// Transaction types
enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  PAYOUT
}

// Transaction states
enum TransactionStatus {
  pending
  completed
  failed
}

//////////////////////////////////////////////////////
// PAYMENT ENUMS (STRIPE / OTHER PROVIDERS)
//////////////////////////////////////////////////////

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  pending
  succeeded
  failed
}

//////////////////////////////////////////////////////
// MEMBERSHIP ENUMS
//////////////////////////////////////////////////////

enum MembershipTier {
  free
  basic
  premium
  investor_plus
}

enum MembershipSubscriptionStatus {
  none
  active
  expired
  canceled
}

enum MembershipApplicationReviewStatus {
  none
  pending
  approved
  rejected
}

//////////////////////////////////////////////////////
// USER TABLE
//////////////////////////////////////////////////////


model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  dob       DateTime?
  country   String?
  // ENUM USED HERE
  idType    IdType?   // Restricted to enum values
  idNumber  String?
  authProvider AuthProvider @default(LOCAL)
  providerId   String?

  role      UserRole    @default(investor) // Default role = investor
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // --- Credential security ---
  // Consecutive failed password attempts. Reset to 0 on any successful login.
  failedLoginAttempts Int       @default(0)
  // Set when failedLoginAttempts crosses the threshold; logins are refused until
  // this passes, which caps online password guessing even from rotating IPs.
  lockedUntil         DateTime?
  // Any JWT issued before this instant is rejected by protect.middleware, so a
  // password reset immediately logs out every existing session on every device.
  passwordChangedAt   DateTime?

  //Relationships
  investments Investment[] //One to many relationship with Investment
  transactions Transaction[] //One to many relationship with Transaction
  payments Payment[] //One to many relationship with Payment
  paymentMethods PaymentMethod[] //One to many relationship with PaymentMethod
  membership                 UserMembership?
  membershipApplications     MembershipApplication[]
  reviewedMembershipApplications MembershipApplication[] @relation("MembershipApplicationReviewer")
  memberEventRegistrations   MemberEventRegistration[]
  passwordResetTokens        PasswordResetToken[]
}

//////////////////////////////////////////////////////
// PASSWORD RESET TOKENS
//////////////////////////////////////////////////////

// Only the SHA-256 hash of the reset token is stored. A leaked database dump
// therefore cannot be used to take over accounts: the raw token exists only in
// the email that was sent, and each row is single-use and short-lived.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  // Retained for abuse investigation (who requested resets for this account).
  requestIp String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
// PROJECT TABLE
//////////////////////////////////////////////////////

model Project {
  id              String   @id @default(uuid())
  title           String
  location        String
  category        String
  minInvestment   Float
  totalFunding    Float
  currentFunding  Float    @default(0)
  investorsCount  Int      @default(0)
  projectedROI    Float
  payoutFrequency String
  fundingDeadline DateTime
  description     String
  features        String[] @default([])
  imageUrl        String
  // ENUM USED HERE
  status          ProjectStatus @default(open)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  //Relationships
  timeline Timeline[] //One to many relationship with Timeline phases
  investments Investment[] //One to many relationship with Investment
  projectImages ProjectImage[]
  payments Payment[] //One to many relationship with Payment
}

model ProjectImage {
  id        String   @id @default(uuid())
  imageUrl  String
  projectId String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
// TIMELINE TABLE
//////////////////////////////////////////////////////

model Timeline {
  id        String   @id @default(uuid())
  phase     String
  // ENUM USED HERE
  status    TimelineStatus
  projectId String // fOREIGN KEY TO PROJECT TABLE ID

  //Relationships
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade) //One to many relationship with Project
}

//////////////////////////////////////////////////////
// INVESTMENT TABLE
//////////////////////////////////////////////////////

model Investment {
  id             String   @id @default(uuid())
  userId         String
  projectId      String
  amountInvested Float
  currentValue   Float?
  totalReturns   Float?   @default(0)
  
  // ENUM USED HERE
  status         InvestmentStatus @default(active)
  investmentDate DateTime @default(now())

  //Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments Payment[]

  
}

//////////////////////////////////////////////////////
// TRANSACTION TABLE
//////////////////////////////////////////////////////

model Transaction {
  id        String   @id @default(uuid())
  userId    String // FOREIGN KEY TO USER TABLE ID
  amount    Float
  // ENUMS USED HERE
  type      TransactionType   // deposit, withdrawal, etc.
  status    TransactionStatus @default(pending) //pending, completed, failed
  // optional reference to a payment that funded this transaction (e.g. INVESTMENT)
  paymentId String?
  createdAt DateTime @default(now())

  //Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade) //One to many relationship with User
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
}

//////////////////////////////////////////////////////
// PAYMENT TABLES
//////////////////////////////////////////////////////

model PaymentMethod {
  id        String          @id @default(uuid())
  userId    String
  provider  PaymentProvider
  methodType String
  label     String?
  // Provider-specific details (e.g., card fingerprint, last4, bank name)
  details   Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  //Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id String @id @default(uuid())

  userId String
  investmentId String?
  projectId String?

  provider PaymentProvider
  status PaymentStatus @default(pending)

  amount Float
  currency String @default("USD")

  // Stripe identifiers (if provider=STRIPE)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?

  paymentMethodId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment Investment? @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  // If you want payments linked to projects independent of investments
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  responses PaymentResponse[]
  transactions Transaction[]
}

model PaymentResponse {
  id String @id @default(uuid())
  paymentId String
  provider PaymentProvider

  // Stripe event id for idempotency / audit
  providerEventId String? @unique

  // Provider-specific response payload
  response Json?
  status String?

  createdAt DateTime @default(now())

  //Relationships
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}


//////////////////////////////////////////////////////
// SETTINGS TABLE (GLOBAL CONFIG)
//////////////////////////////////////////////////////

model Settings {
  id                   String   @id @default("global")
  platformName         String   @default("FIBI")
  supportEmail         String   @default("support@fibi.com")
  contactPhone         String   @default("+254 700 000 000")
  minInvestment        Float    @default(100)
  maxInvestment        Float    @default(50000)
  platformFee          Float    @default(2)
  currency             String   @default("USD")
  depositsEnabled      Boolean  @default(true)
  withdrawalsEnabled   Boolean  @default(true)
  transactionFee       Float    @default(1.5)
  emailNotifications   Boolean  @default(true)
  investmentEmails     Boolean  @default(true)
  adminAlerts          Boolean  @default(true)
  twoFactorAuth        Boolean  @default(false)
  sessionTimeout       Int      @default(30)
  updatedAt            DateTime @updatedAt
}

//////////////////////////////////////////////////////
// MEMBERSHIP (tiers, applications, plans, events)
//////////////////////////////////////////////////////

model UserMembership {
  id                  String                         @id @default(uuid())
  userId              String                         @unique
  tier                MembershipTier                 @default(free)
  status              MembershipSubscriptionStatus   @default(none)
  applicationStatus   MembershipApplicationReviewStatus @default(none)
  renewalDate         DateTime?
  badgeLabel          String?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MembershipApplication {
  id                    String                            @id @default(uuid())
  userId                String
  motivation            String
  interests             String
  communityContribution String
  status                MembershipApplicationReviewStatus @default(pending)
  adminFeedback         String?
  reviewedById          String?
  reviewedAt            DateTime?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("MembershipApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model MembershipPlan {
  id           String           @id @default(uuid())
  tier         MembershipTier   @unique
  name         String
  monthlyPrice Float
  description  String
  features     Json             @default("[]")
  active       Boolean          @default(true)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model MembershipFeatureAccess {
  featureKey String           @id
  minTier    MembershipTier
  updatedAt  DateTime         @updatedAt
}

model MemberEvent {
  id          String           @id @default(uuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  minTier     MembershipTier   @default(basic)
  capacity    Int?
  imageUrl    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  registrations MemberEventRegistration[]
}

model MemberEventRegistration {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  status    String   @default("confirmed")
  createdAt DateTime @default(now())

  event MemberEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}