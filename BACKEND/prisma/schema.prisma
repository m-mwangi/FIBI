// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
} 

//////////////////////////////////////////////////////
// ENUMS (FIXED VALUE SETS)
// These restrict fields to predefined values
//////////////////////////////////////////////////////

// User roles in the system
enum UserRole {
  investor
  admin
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
  APPLE
}

// Identification types (mapped to DB-friendly strings)
enum IdType {
  passport
  national_id   @map("national_id")  // map to national_id in the database
  drivers_license   @map("drivers_license") // map to drivers_license in the database
}

// Project lifecycle states
enum ProjectStatus {
  open
  funded
  active
  closed
}

// Timeline progress states
enum TimelineStatus {
  completed
  in_progress      @map("in-progress")
  upcoming
}

// Investment lifecycle
enum InvestmentStatus {
  pending
  active
  completed
}

// Transaction types
enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  PAYOUT
  MEMBERSHIP
}

// Transaction states
enum TransactionStatus {
  pending
  completed
  failed
}

//////////////////////////////////////////////////////
// PAYMENT ENUMS (STRIPE / OTHER PROVIDERS)
//////////////////////////////////////////////////////

// One member per collection rail. Custody institutions (Morgan Stanley,
// Bank of Singapore) are deliberately absent: they hold funds, they do not
// accept payments, so they can never be a payment provider. See PAYMENTS.md §2.
enum PaymentProvider {
  STRIPE
  MANUAL_WIRE
  MPESA
  ABSA
  SBM
  STANCHART
}

// Slow rails need states a card payment never has. A wire sits in
// `awaiting_funds` for days, and may land short of the expected amount, so
// `partially_settled` has to be representable rather than rounded to
// succeeded/failed.
enum PaymentStatus {
  pending
  awaiting_funds
  partially_settled
  succeeded
  failed
  reversed
}

// Which of the client's institutions an account belongs to. Custody entries are
// read-only holdings; collection entries can appear on wire instructions.
enum BankInstitution {
  SBM
  ABSA
  STANCHART
  MORGAN_STANLEY
  BANK_OF_SINGAPORE
  OTHER
}

enum BankAccountPurpose {
  COLLECTION
  CUSTODY
}

//////////////////////////////////////////////////////
// MEMBERSHIP ENUMS
//////////////////////////////////////////////////////

enum MembershipTier {
  free
  basic
  premium
  investor_plus
}

enum MembershipSubscriptionStatus {
  none
  active
  expired
  canceled
}

enum MembershipApplicationReviewStatus {
  none
  pending
  approved
  rejected
}

// A membership period that has been billed for. `pending` covers the window
// between "member picked a tier" and "money arrived" — on a wire that is days,
// which is why the invoice is a row and not a field on UserMembership.
enum MembershipInvoiceStatus {
  pending
  paid
  failed
  canceled
}

//////////////////////////////////////////////////////
// USER TABLE
//////////////////////////////////////////////////////


model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  dob       DateTime?
  country   String?
  // ENUM USED HERE
  idType    IdType?   // Restricted to enum values
  idNumber  String?
  authProvider AuthProvider @default(LOCAL)
  providerId   String?

  role      UserRole    @default(investor) // Default role = investor
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // --- Credential security ---
  // Consecutive failed password attempts. Reset to 0 on any successful login.
  failedLoginAttempts Int       @default(0)
  // Set when failedLoginAttempts crosses the threshold; logins are refused until
  // this passes, which caps online password guessing even from rotating IPs.
  lockedUntil         DateTime?
  // Any JWT issued before this instant is rejected by protect.middleware, so a
  // password reset immediately logs out every existing session on every device.
  passwordChangedAt   DateTime?
  // Stamped on every successful sign-in (local and OAuth). The admin console
  // reads it to show when an account was last active; nothing else depends on
  // it, so a failed write here must never block a login.
  lastLoginAt         DateTime?

  //Relationships
  investments Investment[] //One to many relationship with Investment
  transactions Transaction[] //One to many relationship with Transaction
  payments Payment[] //One to many relationship with Payment
  paymentMethods PaymentMethod[] //One to many relationship with PaymentMethod
  membership                 UserMembership?
  membershipInvoices         MembershipInvoice[]
  membershipApplications     MembershipApplication[]
  reviewedMembershipApplications MembershipApplication[] @relation("MembershipApplicationReviewer")
  memberEventRegistrations   MemberEventRegistration[]
  passwordResetTokens        PasswordResetToken[]
  adminAuditLogs             AdminAuditLog[]
}

//////////////////////////////////////////////////////
// BANK ACCOUNTS
//////////////////////////////////////////////////////

// The real-world accounts behind the platform: where investor money is
// collected, and where pooled funds are custodied.
//
// A row rather than config so an operator can add a bank without a deploy, and
// so wire instructions always quote the account that actually matches the
// investor's currency.
model BankAccount {
  id            String             @id @default(uuid())
  label         String
  institution   BankInstitution
  purpose       BankAccountPurpose @default(COLLECTION)
  bankName      String
  accountName   String
  accountNumber String
  swiftCode     String?
  branch        String?
  // ISO-4217. An account holds one currency; a bank offering both KES and USD
  // is two rows, matching how the bank actually operates them.
  currency      String
  instructions  String?
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  statements BankStatement[]

  // At most one active collection account per currency, so wire instructions
  // are never ambiguous about where to send money. That rule is a PARTIAL
  // unique index, which Prisma's schema language cannot express — it lives in
  // the Phase 2 migration SQL. Do not assume `migrate diff` knows about it.
  @@index([currency, purpose, active])
}

//////////////////////////////////////////////////////
// BANK STATEMENTS / RECONCILIATION
//////////////////////////////////////////////////////

enum StatementLineStatus {
  unmatched
  matched
  ignored
}

// One imported statement file.
//
// Reconciliation is not a stopgap for missing bank APIs — it is permanent.
// Money arrives that no API announces: a mistyped reference, a correspondent
// wire, a deposit made at a branch counter. A system that only sees payments it
// initiated will silently lose investor money.
model BankStatement {
  id            String   @id @default(uuid())
  bankAccountId String
  filename      String
  // CSV | MT940 | CAMT053
  format        String
  periodStart   DateTime?
  periodEnd     DateTime?
  importedById  String?
  importedAt    DateTime @default(now())
  lineCount     Int      @default(0)
  // SHA-256 of the raw file. Unique, so re-uploading the same statement is
  // rejected rather than duplicating every credit in it.
  fileHash      String   @unique

  bankAccount BankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  lines       StatementLine[]

  @@index([bankAccountId])
  @@index([importedAt])
}

// One transaction line from a statement.
model StatementLine {
  id          String   @id @default(uuid())
  statementId String
  // Signed integer MINOR units: credits positive (money in), debits negative.
  amountMinor BigInt
  currency    String
  valueDate   DateTime
  // Raw text exactly as the bank sent it — never normalised in place, because
  // the original is what an operator needs when investigating a break.
  reference    String?
  description  String?
  counterparty String?

  status           StatementLineStatus @default(unmatched)
  matchedPaymentId String?
  matchedAt        DateTime?
  matchedById      String?
  // Why this line was auto-matched, or why it could not be.
  matchNote        String?

  // Identity of the line within its statement, so a partially re-imported file
  // cannot double-count a credit.
  lineHash String

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([statementId, lineHash])
  @@index([status])
  @@index([valueDate])
  @@index([matchedPaymentId])
}

//////////////////////////////////////////////////////
// LEDGER (double-entry, append-only)
//////////////////////////////////////////////////////

// What kind of money an account holds. Escrow is deliberately separate from
// platform accounts: investor funds are client money and must never be
// commingled with operating funds.
enum LedgerAccountType {
  INVESTOR_WALLET
  PROJECT_ESCROW
  PLATFORM_FEE
  BANK_SETTLEMENT
  FX_SUSPENSE
  CUSTODY
}

// An account holds exactly one currency. A multi-currency balance is two
// accounts, never one account with a mixed total.
model LedgerAccount {
  id          String            @id @default(uuid())
  type        LedgerAccountType
  currency    String
  // User id or project id depending on `type`; null for platform-level accounts.
  ownerId     String?
  // Bank account reference where this maps to a real external account.
  externalRef String?
  createdAt   DateTime          @default(now())

  postings LedgerPosting[]

  // One account per (type, owner, currency) — prevents a second USD escrow
  // account quietly appearing for the same project and splitting its balance.
  @@unique([type, ownerId, currency])
  @@index([ownerId])
}

// One balanced financial event. Postings within an entry sum to zero per
// currency; this is enforced in application code and asserted in tests.
//
// Append-only: entries and postings are never updated or deleted. A correction
// is a new reversing entry. That is what makes the ledger auditable.
model JournalEntry {
  id             String   @id @default(uuid())
  // Natural key from the source event (Stripe event id, statement line hash).
  // Unique, so replaying a webhook cannot post the same money twice.
  idempotencyKey String   @unique
  description    String
  occurredAt     DateTime
  createdAt      DateTime @default(now())
  paymentId      String?

  postings LedgerPosting[]

  @@index([occurredAt])
}

model LedgerPosting {
  id        String @id @default(uuid())
  entryId   String
  accountId String
  // Signed integer MINOR units. Debits positive, credits negative.
  amount    BigInt
  currency  String

  entry   JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([entryId])
}

//////////////////////////////////////////////////////
// ADMIN AUDIT LOG
//////////////////////////////////////////////////////

// An append-only record of every state-changing action an admin takes through
// the console: deletions, project edits, membership decisions, settings saves.
//
// The actor is stored twice on purpose. `actorId` keeps the live relation for
// joins, but it is nulled when that admin's account is deleted — so
// `actorEmail` is denormalised alongside it, and the history still says who did
// what after the account is gone. Deleting an admin must not rewrite the past.
model AdminAuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorEmail  String
  // Dotted verb, e.g. "user.delete", "project.update", "settings.update".
  action      String
  // What was acted on: "user" | "project" | "settings" | "membership" | "feature".
  targetType  String
  targetId    String?
  // Human label captured at the time, so a deleted target still reads as a name
  // rather than a dangling uuid.
  targetLabel String?
  // Action-specific detail (changed fields, before/after tier, …).
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([targetType, targetId])
}

//////////////////////////////////////////////////////
// PASSWORD RESET TOKENS
//////////////////////////////////////////////////////

// Only the SHA-256 hash of the reset token is stored. A leaked database dump
// therefore cannot be used to take over accounts: the raw token exists only in
// the email that was sent, and each row is single-use and short-lived.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  // Retained for abuse investigation (who requested resets for this account).
  requestIp String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
// PROJECT TABLE
//////////////////////////////////////////////////////

model Project {
  id              String   @id @default(uuid())
  title           String
  location        String
  category        String
  // Money: integer MINOR units (cents). See utils/money.js.
  // The `Minor` suffix is deliberate — a caller still reading the old `Float`
  // name gets `undefined` and fails loudly, rather than silently rendering a
  // value 100x wrong.
  minInvestmentMinor  BigInt
  totalFundingMinor   BigInt
  currentFundingMinor BigInt @default(0)
  // ISO-4217. Every amount carries its own currency; there is no global default.
  currency        String   @default("USD")
  investorsCount  Int      @default(0)
  // A percentage, not money — stays Float.
  projectedROI    Float
  payoutFrequency String
  fundingDeadline DateTime
  description     String
  features        String[] @default([])
  imageUrl        String
  // ENUM USED HERE
  status          ProjectStatus @default(open)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  //Relationships
  timeline Timeline[] //One to many relationship with Timeline phases
  investments Investment[] //One to many relationship with Investment
  projectImages ProjectImage[]
  payments Payment[] //One to many relationship with Payment
}

model ProjectImage {
  id        String   @id @default(uuid())
  imageUrl  String
  projectId String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
// TIMELINE TABLE
//////////////////////////////////////////////////////

model Timeline {
  id        String   @id @default(uuid())
  phase     String
  // ENUM USED HERE
  status    TimelineStatus
  projectId String // fOREIGN KEY TO PROJECT TABLE ID

  //Relationships
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade) //One to many relationship with Project
}

//////////////////////////////////////////////////////
// INVESTMENT TABLE
//////////////////////////////////////////////////////

model Investment {
  id             String   @id @default(uuid())
  userId         String
  projectId      String
  // Money: integer MINOR units. See utils/money.js.
  amountInvestedMinor BigInt
  currentValueMinor   BigInt?
  totalReturnsMinor   BigInt?  @default(0)
  currency            String   @default("USD")

  // ENUM USED HERE
  status         InvestmentStatus @default(active)
  investmentDate DateTime @default(now())

  //Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments Payment[]

  
}

//////////////////////////////////////////////////////
// TRANSACTION TABLE
//////////////////////////////////////////////////////

model Transaction {
  id        String   @id @default(uuid())
  userId    String // FOREIGN KEY TO USER TABLE ID
  // Money: integer MINOR units. See utils/money.js.
  amountMinor BigInt
  currency  String   @default("USD")
  // ENUMS USED HERE
  type      TransactionType   // deposit, withdrawal, etc.
  status    TransactionStatus @default(pending) //pending, completed, failed
  // optional reference to a payment that funded this transaction (e.g. INVESTMENT)
  paymentId String?
  createdAt DateTime @default(now())

  //Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade) //One to many relationship with User
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
}

//////////////////////////////////////////////////////
// PAYMENT TABLES
//////////////////////////////////////////////////////

model PaymentMethod {
  id        String          @id @default(uuid())
  userId    String
  provider  PaymentProvider
  methodType String
  label     String?
  // Provider-specific details (e.g., card fingerprint, last4, bank name)
  details   Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  //Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id String @id @default(uuid())

  userId String
  investmentId String?
  projectId String?

  provider PaymentProvider
  status PaymentStatus @default(pending)

  // Money: integer MINOR units. See utils/money.js.
  amountMinor BigInt
  currency String @default("USD")

  // Provider-agnostic identity. `providerRef` is whatever that rail calls its
  // handle (Stripe session id, wire reference, M-Pesa checkout id); everything
  // else the rail returns goes in `providerMeta`. Previously these were two
  // Stripe-named columns on the shared table, which meant every new provider
  // added more nullable columns nobody else used.
  providerRef  String?
  providerMeta Json?

  // How much has actually settled, for rails that can land short of the ask.
  // Equals `amountMinor` on a clean settlement.
  settledAmountMinor BigInt @default(0)

  paymentMethodId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment Investment? @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  // If you want payments linked to projects independent of investments
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  responses PaymentResponse[]
  transactions Transaction[]
  membershipInvoice MembershipInvoice?

  // Looking a payment up by its provider handle is the hot path in every
  // webhook and every statement match.
  @@index([provider, providerRef])
}

model PaymentResponse {
  id String @id @default(uuid())
  paymentId String
  provider PaymentProvider

  // Stripe event id for idempotency / audit
  providerEventId String? @unique

  // Provider-specific response payload
  response Json?
  status String?

  createdAt DateTime @default(now())

  //Relationships
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}


//////////////////////////////////////////////////////
// SETTINGS TABLE (GLOBAL CONFIG)
//////////////////////////////////////////////////////

model Settings {
  id                   String   @id @default("global")
  platformName         String   @default("FIBI")
  supportEmail         String   @default("support@fibi.com")
  contactPhone         String   @default("+254 700 000 000")
  // Money: integer MINOR units. See utils/money.js.
  minInvestmentMinor   BigInt   @default(10000)
  maxInvestmentMinor   BigInt   @default(5000000)
  // Percentages, not money — stay Float.
  platformFee          Float    @default(2)
  currency             String   @default("USD")
  depositsEnabled      Boolean  @default(true)
  withdrawalsEnabled   Boolean  @default(true)
  transactionFee       Float    @default(1.5)
  emailNotifications   Boolean  @default(true)
  investmentEmails     Boolean  @default(true)
  adminAlerts          Boolean  @default(true)
  twoFactorAuth        Boolean  @default(false)
  sessionTimeout       Int      @default(30)
  updatedAt            DateTime @updatedAt
}

//////////////////////////////////////////////////////
// MEMBERSHIP (tiers, applications, plans, events)
//////////////////////////////////////////////////////

model UserMembership {
  id                  String                         @id @default(uuid())
  userId              String                         @unique
  tier                MembershipTier                 @default(free)
  status              MembershipSubscriptionStatus   @default(none)
  applicationStatus   MembershipApplicationReviewStatus @default(none)
  // End of the paid period. Past this instant the membership is expired, and
  // `expireDueMemberships` in membership.service is what makes that true in the
  // database rather than only in the reader's head.
  renewalDate         DateTime?
  badgeLabel          String?

  // When the member first became active. Kept separate from createdAt, which is
  // when the row appeared — every signed-in user gets a row at `free`.
  startedAt           DateTime?
  // Set when the member cancels. The membership keeps its tier until
  // `renewalDate` passes; cancelling is "do not bill me again", not "cut me off
  // mid-period".
  canceledAt          DateTime?
  // Tier the member has paid to move to, applied when the invoice settles. An
  // upgrade that is awaiting a wire must not grant access before the money.
  pendingTier         MembershipTier?

  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The expiry sweep scans on this; without the index it is a full table scan
  // on every tick.
  @@index([status, renewalDate])
}

// One billed membership period. Created when a member starts checkout, settled
// by the same `settlePayment` path that settles an investment — so a card and a
// bank wire activate a membership through identical code.
model MembershipInvoice {
  id           String                  @id @default(uuid())
  userId       String
  tier         MembershipTier
  // Money: integer MINOR units. See utils/money.js.
  amountMinor  BigInt
  currency     String                  @default("USD")
  status       MembershipInvoiceStatus @default(pending)
  // The period this invoice buys. Set at creation so a member can see what they
  // are paying for before the money lands.
  periodStart  DateTime
  periodEnd    DateTime
  paidAt       DateTime?
  paymentId    String?                 @unique
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
}

model MembershipApplication {
  id                    String                            @id @default(uuid())
  userId                String
  motivation            String
  interests             String
  communityContribution String
  status                MembershipApplicationReviewStatus @default(pending)
  adminFeedback         String?
  reviewedById          String?
  reviewedAt            DateTime?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("MembershipApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model MembershipPlan {
  id           String           @id @default(uuid())
  tier         MembershipTier   @unique
  name         String
  // Money: integer MINOR units. See utils/money.js.
  monthlyPriceMinor BigInt
  currency     String           @default("USD")
  description  String
  features     Json             @default("[]")
  active       Boolean          @default(true)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model MembershipFeatureAccess {
  featureKey String           @id
  minTier    MembershipTier
  updatedAt  DateTime         @updatedAt
}

model MemberEvent {
  id          String           @id @default(uuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  minTier     MembershipTier   @default(basic)
  capacity    Int?
  imageUrl    String?
  // Cancelled or draft events stay in the table — registrations reference them
  // and members should still see that the thing they booked was called off.
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  registrations MemberEventRegistration[]

  @@index([startsAt])
}

model MemberEventRegistration {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  // "confirmed" | "canceled". Cancelling keeps the row so the unique pair still
  // holds and a member can re-book without a duplicate-key error.
  status    String   @default("confirmed")
  canceledAt DateTime?
  createdAt DateTime @default(now())

  event MemberEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}
//////////////////////////////////////////////////////
// OUTBOUND INTEGRATION CREDENTIALS
//////////////////////////////////////////////////////

// Long-lived provider refresh tokens for server-to-server integrations, one row
// per provider ("zoho"). These are not user sessions: there is a single FIBI
// mailbox, authorized once by an admin, and the server mints its own hourly
// access tokens from the stored refresh token.
//
// The refresh token is stored as issued because it must be replayable against
// the provider — unlike PasswordResetToken above, a one-way hash would make it
// useless. It is therefore a live credential at rest: restrict database access
// accordingly, and prefer ZOHO_REFRESH_TOKEN in the environment where the
// deployment can inject secrets directly.
model OAuthCredential {
  id               String   @id @default(uuid())
  provider         String   @unique
  refreshToken     String
  scope            String?
  // The mailbox/account the token belongs to, for display in the admin console.
  accountEmail     String?
  // Who ran the connect flow, captured at the time so the record survives their
  // account being deleted.
  connectedById    String?
  connectedByEmail String?
  connectedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
